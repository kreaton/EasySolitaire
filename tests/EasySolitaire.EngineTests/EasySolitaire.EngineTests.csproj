<Project Sdk="Microsoft.NET.Sdk">

  <!-- Plain console project: compiles the game engine straight from the app, needs no NuGet packages. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>EasySolitaire.EngineTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/EasySolitaire/Engine/*.cs" Link="Engine/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
